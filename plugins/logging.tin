#NOP --------------------------------------------------------------------------;
#NOP Logging class.;
#NOP --------------------------------------------------------------------------;
#CLASS {logging} {OPEN};

#NOP --------------------------------------------------------------------------;
#NOP Variables.;
#NOP --------------------------------------------------------------------------;

#NOP Format for log messages.;
#VARIABLE {LOGGING_TRACE_FORMAT} {<107>};
#VARIABLE {LOGGING_DEBUG_FORMAT} {<120>};
#VARIABLE {LOGGING_INFO_FORMAT} {<160>};
#VARIABLE {LOGGING_WARNING_FORMAT} {<130>};
#VARIABLE {LOGGING_ERROR_FORMAT} {<110>};
#VARIABLE {LOGGING_ECHO_FORMAT} {<150>};

#NOP Specify a buffer to add log messages to.;
#VARIABLE {LOGGING_BUFFER} {};

#NOP Specify whether or not to echo logs. Handy if you're funneling them to a;
#NOP buffer and don't need to also see them in the main feed.;
#VARIABLE {LOGGING_ECHO} {1};

#NOP Controls which log messages to display. Set via aliases.;
#VARIABLE {LOG_LEVEL} {3};

#NOP --------------------------------------------------------------------------;
#NOP Aliases.;
#NOP --------------------------------------------------------------------------;

#NOP Base log message alias.;
#NOP %1 - Message.;
#NOP %2 - Format code.;
#ALIAS {__logMessage} {
    #NOP %0;
    #NOP Get timestamp.;
    #LOCAL {timestamp} {};
    #FORMAT {timestamp} {[%t]} {%Y-%m-%d %H:%M:%S};

    #NOP Get format code.;
    #LOCAL {format} {%2};

    #NOP Echo the message.;
    #IF {$LOGGING_ECHO} {
        #LINE {IGNORE} {#ECHO {$format$timestamp %1<088>}};
    };

    #NOP Add to a buffer if specified.;
    #IF {"$LOGGING_BUFFER" != ""} {
        _bufferAdd {$LOGGING_BUFFER} {$format$timestamp %1<088>};
    };
};

#NOP Log a trace message.;
#NOP %1 - Message.;
#ALIAS {_trace} {
    #NOP %0;
    #IF {$LOG_LEVEL >= 5} {
        __logMessage {TRACE: %1} {$LOGGING_TRACE_FORMAT};
    };
};

#NOP Log a debug message.;
#NOP %1 - Message.;
#ALIAS {_debug} {
    #NOP %0;
    #IF {$LOG_LEVEL >= 4} {
        __logMessage {DEBUG: %1} {$LOGGING_DEBUG_FORMAT};
    };
};

#NOP Log an info message.;
#NOP %1 - Message.;
#ALIAS {_info} {
    #NOP %0;
    #IF {$LOG_LEVEL >= 3} {
        __logMessage {INFO: %1} {$LOGGING_INFO_FORMAT};
    };
};

#NOP Log a warning message.;
#NOP %1 - Message.;
#ALIAS {_warn} {
    #NOP %0;
    #IF {$LOG_LEVEL >= 2} {
        __logMessage {WARN: %1} {$LOGGING_WARNING_FORMAT};
    };
};

#NOP Log an error message.;
#NOP %1 - Message.;
#ALIAS {_error} {
    #NOP %0;
    #IF {$LOG_LEVEL >= 1} {
        __logMessage {ERROR: %1} {$LOGGING_ERROR_FORMAT};
    };
};

#NOP Write output as an echo.;
#NOP %1 - Message.;
#ALIAS {_echo} {
    #NOP %0;

    #NOP Echo the message.;
    #IF {$LOGGING_ECHO} {
        #LINE {IGNORE} {#ECHO {${LOGGING_ECHO_FORMAT}%1<088>}};
    };
};

#NOP Set the buffer to record log messages in.;
#NOP %1 - Name of the buffer.;
#ALIAS {_loggingSetBuffer} {
    #NOP %0;
    #VARIABLE {LOGGING_BUFFER} {%1};
    _info {Buffer for logging has been set to '%1'.};
};

#NOP Set echo state.;
#ALIAS {_loggingSetEcho} {
    #NOP %0;
    #LOCAL {set} {};
    #FORMAT {set} {%u} {%1};

    #IF {"$set" == "ON"} {
        #VARIABLE {LOGGING_ECHO} {1};
        _info {Logging echo is now ON.};
    }; #ELSE {
        VARIABLE {LOGGING_ECHO} {0};
        _info {Logging echo is now OFF.};
    };
};

#NOP Set log level.;
#ALIAS {_loggingSetLevel} {
    #NOP %0;
    #LOCAL {level} {};
    #FORMAT {level} {%u} {%1};

    #IF {"$level" == "TRACE"} {
        #VARIABLE {LOG_LEVEL} {5};
        _trace {Log level set to trace.};
    }; #ELSEIF {"$level" == "DEBUG"} {
        #VARIABLE {LOG_LEVEL} {4};
        _debug {Log level set to debug.};
    }; #ELSEIF {"$level" == "INFO"} {
        #VARIABLE {LOG_LEVEL} {3};
        _info {Log level set to info.};
    }; #ELSEIF {"$level" == "WARNING"} {
        #VARIABLE {LOG_LEVEL} {2};
        _warn {Log level set to warning.};
    }; #ELSE {
        #VARIABLE {LOG_LEVEL} {1};
        _error {Log level set to error.};
    };
};

#NOP Create logging plugin and commands.
#ALIAS {_loggingCreatePlugin} {
    #NOP %0;
    #CLASS {logging} {OPEN};

    _pluginCreate {logging} {Logging and echo functions};

    _pluginCreateCommand
        {logging}
        {trace}
        {_trace}
        {Write a trace log message}
        {
            {1} {Log message}
        };

    _pluginCreateCommand
        {logging}
        {debug}
        {_debug}
        {Write a debug log message}
        {
            {1} {Log message}
        };

    _pluginCreateCommand
        {logging}
        {info}
        {_info}
        {Write a info log message}
        {
            {1} {Log message}
        };

    _pluginCreateCommand
        {logging}
        {warn}
        {_warn}
        {Write a warning log message}
        {
            {1} {Log message}
        };

    _pluginCreateCommand
        {logging}
        {error}
        {_error}
        {Write a error log message}
        {
            {1} {Log message}
        };

    _pluginCreateCommand
        {logging}
        {echo}
        {_echo}
        {Directly echo a message}
        {
            {1} {Message}
        }
        {This output is not controlled by other logging settings. It's basically just so that there's a central place to control the formatting of echoed messages.};

    _pluginCreateCommand
        {logging}
        {setBuffer}
        {_loggingSetBuffer}
        {Specify a text buffer for log messages to be written to}
        {
            {1} {Buffer name}
        };

    _pluginCreateCommand
        {logging}
        {setEcho}
        {_loggingSetEcho}
        {Enable or disable writing logs as echo messages}
        {
            {1} {on|off}
        };

    _pluginCreateCommand
        {logging}
        {setLevel}
        {_loggingSetLevel}
        {Set the verbosity of logging}
        {
            {1} {debug|info|warning|error}
        };

    #CLASS {logging} {CLOSE};
};

#CLASS {logging} {CLOSE};
